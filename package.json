{
  "name": "artist-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run --workspace=@artist/web start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:push": "turbo run db:push --filter=@artist/database",
    "db:studio": "turbo run db:studio --filter=@artist/database"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "description": "Artist Intelligence Platform — full-stack analytics for artist growth"
}
